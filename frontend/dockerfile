# ============ STAGE 1: Builder ============
FROM node:22-alpine AS builder

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем только файлы пакетного менеджера для максимального кэширования
COPY package*.json ./
# Если используешь pnpm или yarn — замени на соответствующие файлы

# Устанавливаем зависимости (включая devDependencies, т.к. нужны для сборки)
RUN npm ci --legacy-peer-deps

# Копируем весь исходный код
COPY . .

# Собираем продакшен-билд
RUN npm run build

# ============ STAGE 2: Runtime (nginx) ============
FROM nginx:alpine AS runtime

# Копируем кастомный nginx конфиг (рекомендую, чтобы правильно обрабатывать Vue Router history mode)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Копируем собранные статик-файлы из билдера
COPY --from=builder /app/dist /usr/share/nginx/html

# Опционально: выставляем метку с версией
ARG GIT_COMMIT=unknown
LABEL org.label-schema.vcs-ref=$GIT_COMMIT \
      org.label-schema.build-date=$BUILD_DATE

# Порт по умолчанию для nginx
EXPOSE 80

# nginx запускается автоматически в alpine-образе
CMD ["nginx", "-g", "daemon off;"]